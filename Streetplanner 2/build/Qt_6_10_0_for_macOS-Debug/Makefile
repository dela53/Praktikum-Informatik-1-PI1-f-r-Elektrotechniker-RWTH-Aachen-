####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Streetplanner/bin || mkdir -p $(INSTALL_ROOT)/opt/Streetplanner/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Streetplanner/bin/Streetplanner.app
	
	$(QINSTALL) Streetplanner.app $(INSTALL_ROOT)/opt/Streetplanner/bin/Streetplanner.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/Streetplanner/bin/Streetplanner.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Streetplanner/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

