qmake: FORCE
	@$(QMAKE) -o Makefile ../../Streetplanner.pro -spec macx-clang CONFIG+=debug CONFIG+=qml_debug

qmake_all: FORCE

Streetplanner.app/Contents/PkgInfo: 
	@test -d Streetplanner.app/Contents || mkdir -p Streetplanner.app/Contents
	@$(DEL_FILE) Streetplanner.app/Contents/PkgInfo
	@echo "APPL????" > Streetplanner.app/Contents/PkgInfo
Streetplanner.app/Contents/Info.plist: 
	@test -d Streetplanner.app/Contents || mkdir -p Streetplanner.app/Contents
	@$(DEL_FILE) Streetplanner.app/Contents/Info.plist
	@plutil -convert xml1 -o - ../../../Qt/6.10.0/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,-bung.Streetplanner,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},-bung.Streetplanner,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,Streetplanner,g" -e "s,@LIBRARY@,Streetplanner,g" -e "s,\$${EXECUTABLE_NAME},Streetplanner,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >Streetplanner.app/Contents/Info.plist

all: Makefile \
		Streetplanner.app/Contents/PkgInfo \
		Streetplanner.app/Contents/Info.plist Streetplanner.app/Contents/MacOS/Streetplanner

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../Streetplanner_de_DE.ts $(DISTDIR)/
	$(COPY_FILE) --parents qmake_qmake_qm_files.qrc $(DISTDIR)/
	$(COPY_FILE) --parents ../../abstractmap.h ../../addstreet_dialog.h ../../bigtown.h ../../city.h ../../dialog.h ../../dijkstra.h ../../mainwindow.h ../../map.h ../../mapio.h ../../mapiofileinput.h ../../mapionrw.h ../../smalltown.h ../../street.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../abstractmap.cpp ../../addstreet_dialog.cpp ../../bigtown.cpp ../../city.cpp ../../dialog.cpp ../../dijkstra.cpp ../../main.cpp ../../mainwindow.cpp ../../map.cpp ../../mapio.cpp ../../mapiofileinput.cpp ../../mapionrw.cpp ../../smalltown.cpp ../../street.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../../addstreet_dialog.ui ../../dialog.ui ../../mainwindow.ui $(DISTDIR)/
	$(COPY_FILE) --parents ../../Streetplanner_de_DE.ts $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) -r Streetplanner.app
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


####### Sub-libraries

